# source chains
ETH_MAINNET_RPC=https://eth.merkle.io
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network

# chainkeys are NOT portable: Ethereum mainnet is 3 on CC3 testnet, 1 on CC3 mainnet
CHAIN_KEY=3

# deployed contracts
REGISTER_ADDRESS=
VERIFIER_ADDRESS=
PAYMENT_ADAPTER_ADDRESS=
SILENCE_ADAPTER_ADDRESS=
BOND_ADDRESS=

# keeper signer (never commit a real key)
KEEPER_PRIVATE_KEY=
DRY_RUN=1

# proof builders, comma separated, in preference order
PROOF_BUILDERS=https://proof-gen-api.cc3-testnet.creditcoin.network

# lens
PORT=8787
