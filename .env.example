# ── source chains ────────────────────────────────────────────────────────
# Any Ethereum mainnet RPC. Archive access helps for deep-history proofs.
ETH_MAINNET_RPC=https://eth.merkle.io

# Creditcoin CC3 testnet. EVM chainId 102031.
# Explorer: https://creditcoin-testnet.blockscout.com/
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network

# Chainkeys are NOT portable between environments:
#   CC3 testnet -> Ethereum mainnet = 3, Sepolia = 1
#   CC3 mainnet -> Ethereum mainnet = 1
# The deploy script resolves and asserts this rather than trusting it.
CHAIN_KEY=3
EXPECTED_CHAIN_ID=1

# ── proof builders, in preference order ──────────────────────────────────
# More than one on purpose: a builder can censor but never forge, and a
# withheld proof is indistinguishable from a missed payment until the cure
# window closes.
PROOF_BUILDERS=https://proof-gen-api.cc3-testnet.creditcoin.network

# ── deployment ───────────────────────────────────────────────────────────
PRIVATE_KEY=
TIMELOCK=
# Deployed by script/Deploy.s.sol; also written to deployments/<chainid>.json
REGISTER_ADDRESS=
VERIFIER_ADDRESS=
PAYMENT_ADAPTER_ADDRESS=
SILENCE_ADAPTER_ADDRESS=
BOND_ADDRESS=
COLLATERAL=

# ── keeper ───────────────────────────────────────────────────────────────
KEEPER_PRIVATE_KEY=
DRY_RUN=1

# ── lens ─────────────────────────────────────────────────────────────────
PORT=8787
